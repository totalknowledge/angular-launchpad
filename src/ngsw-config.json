{
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/api/**",
    "!/api/v0/**",
    "!/.well-known/**"
  ],
  "assetGroups": [{
    "name": "app",
    "installMode": "prefetch",
    "resources": {
      "files": [
        "/favicon.ico",
        "/index.html",
        "/manifest.webmanifest",
        "/*.css",
        "/*.js"
      ]
    }
  }, {
    "name": "assets",
    "installMode": "lazy",
    "updateMode": "prefetch",
    "resources": {
      "files": [
        "/assets/**"
      ]
    }
  }]
}
